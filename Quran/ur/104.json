{"id":104,"name":"الهمزة","transliteration":"Al-Humazah","translation":"عیب لگانے والا","type":"meccan","total_verses":9,"verses":[{"id":1,"text":"وَيۡلٞ لِّكُلِّ هُمَزَةٖ لُّمَزَةٍ","translation":"ہر طعن آمیز اشارتیں کرنے والے چغل خور کی خرابی ہے","transliteration":"Waylun likulli humazatin lumazatin"},{"id":2,"text":"ٱلَّذِي جَمَعَ مَالٗا وَعَدَّدَهُۥ","translation":"جو مال جمع کرتا اور اس کو گن گن کر رکھتا ہے","transliteration":"Allathee jamaAAa malan waAAaddadahu"},{"id":3,"text":"يَحۡسَبُ أَنَّ مَالَهُۥٓ أَخۡلَدَهُۥ","translation":"(اور) خیال کرتا ہے کہ اس کا مال اس کی ہمیشہ کی زندگی کا موجب ہو گا","transliteration":"Yahsabu anna malahu akhladahu"},{"id":4,"text":"كَلَّاۖ لَيُنۢبَذَنَّ فِي ٱلۡحُطَمَةِ","translation":"ہر گز نہیں وہ ضرور حطمہ میں ڈالا جائے گا","transliteration":"Kalla layunbathanna fee alhutamati"},{"id":5,"text":"وَمَآ أَدۡرَىٰكَ مَا ٱلۡحُطَمَةُ","translation":"اور تم کیا سمجھے حطمہ کیا ہے؟","transliteration":"Wama adraka ma alhutamatu"},{"id":6,"text":"نَارُ ٱللَّهِ ٱلۡمُوقَدَةُ","translation":"وہ خدا کی بھڑکائی ہوئی آگ ہے","transliteration":"Naru Allahi almooqadatu"},{"id":7,"text":"ٱلَّتِي تَطَّلِعُ عَلَى ٱلۡأَفۡـِٔدَةِ","translation":"جو دلوں پر جا لپٹے گی","transliteration":"Allatee tattaliAAu AAala alafidati"},{"id":8,"text":"إِنَّهَا عَلَيۡهِم مُّؤۡصَدَةٞ","translation":"(اور) وہ اس میں بند کر دیئے جائیں گے","transliteration":"lnnaha AAalayhim musadatun"},{"id":9,"text":"فِي عَمَدٖ مُّمَدَّدَةِۭ","translation":"(یعنی آگ کے) لمبے لمبے ستونوں میں","transliteration":"Fee AAamadin mumaddadatin"}]}
