{"id":80,"name":"عبس","transliteration":"'Abasa","translation":"تیوری چڑہائی","type":"meccan","total_verses":42,"verses":[{"id":1,"text":"عَبَسَ وَتَوَلَّىٰٓ","translation":"(محمد مصطفٰےﷺ) ترش رُو ہوئے اور منہ پھیر بیٹھے","transliteration":"AAabasa watawalla"},{"id":2,"text":"أَن جَآءَهُ ٱلۡأَعۡمَىٰ","translation":"کہ ان کے پاس ایک نابینا آیا","transliteration":"An jaahu alaAAma"},{"id":3,"text":"وَمَا يُدۡرِيكَ لَعَلَّهُۥ يَزَّكَّىٰٓ","translation":"اور تم کو کیا خبر شاید وہ پاکیزگی حاصل کرتا","transliteration":"Wama yudreeka laAAallahu yazzakka"},{"id":4,"text":"أَوۡ يَذَّكَّرُ فَتَنفَعَهُ ٱلذِّكۡرَىٰٓ","translation":"یا سوچتا تو سمجھانا اسے فائدہ دیتا","transliteration":"Aw yaththakkaru fatanfaAAahu alththikra"},{"id":5,"text":"أَمَّا مَنِ ٱسۡتَغۡنَىٰ","translation":"جو پروا نہیں کرتا","transliteration":"Amma mani istaghna"},{"id":6,"text":"فَأَنتَ لَهُۥ تَصَدَّىٰ","translation":"اس کی طرف تو تم توجہ کرتے ہو","transliteration":"Faanta lahu tasadda"},{"id":7,"text":"وَمَا عَلَيۡكَ أَلَّا يَزَّكَّىٰ","translation":"حالانکہ اگر وہ نہ سنورے تو تم پر کچھ (الزام) نہیں","transliteration":"Wama AAalayka alla yazzakka"},{"id":8,"text":"وَأَمَّا مَن جَآءَكَ يَسۡعَىٰ","translation":"اور جو تمہارے پاس دوڑتا ہوا آیا","transliteration":"Waamma man jaaka yasAAa"},{"id":9,"text":"وَهُوَ يَخۡشَىٰ","translation":"اور (خدا سے) ڈرتا ہے","transliteration":"Wahuwa yakhsha"},{"id":10,"text":"فَأَنتَ عَنۡهُ تَلَهَّىٰ","translation":"اس سے تم بےرخی کرتے ہو","transliteration":"Faanta AAanhu talahha"},{"id":11,"text":"كَلَّآ إِنَّهَا تَذۡكِرَةٞ","translation":"دیکھو یہ (قرآن) نصیحت ہے","transliteration":"Kalla innaha tathkiratun"},{"id":12,"text":"فَمَن شَآءَ ذَكَرَهُۥ","translation":"پس جو چاہے اسے یاد رکھے","transliteration":"Faman shaa thakarahu"},{"id":13,"text":"فِي صُحُفٖ مُّكَرَّمَةٖ","translation":"قابل ادب ورقوں میں (لکھا ہوا)","transliteration":"Fee suhufin mukarramatin"},{"id":14,"text":"مَّرۡفُوعَةٖ مُّطَهَّرَةِۭ","translation":"جو بلند مقام پر رکھے ہوئے (اور) پاک ہیں","transliteration":"MarfooAAatin mutahharatin"},{"id":15,"text":"بِأَيۡدِي سَفَرَةٖ","translation":"لکھنے والوں کے ہاتھوں میں","transliteration":"Biaydee safaratin"},{"id":16,"text":"كِرَامِۭ بَرَرَةٖ","translation":"جو سردار اور نیکو کار ہیں","transliteration":"Kiramin bararatin"},{"id":17,"text":"قُتِلَ ٱلۡإِنسَٰنُ مَآ أَكۡفَرَهُۥ","translation":"انسان ہلاک ہو جائے کیسا ناشکرا ہے","transliteration":"Qutila alinsanu ma akfarahu"},{"id":18,"text":"مِنۡ أَيِّ شَيۡءٍ خَلَقَهُۥ","translation":"اُسے (خدا نے) کس چیز سے بنایا؟","transliteration":"Min ayyi shayin khalaqahu"},{"id":19,"text":"مِن نُّطۡفَةٍ خَلَقَهُۥ فَقَدَّرَهُۥ","translation":"نطفے سے بنایا پھر اس کا اندازہ مقرر کیا","transliteration":"Min nutfatin khalaqahu faqaddarahu"},{"id":20,"text":"ثُمَّ ٱلسَّبِيلَ يَسَّرَهُۥ","translation":"پھر اس کے لیے رستہ آسان کر دیا","transliteration":"Thumma alssabeela yassarahu"},{"id":21,"text":"ثُمَّ أَمَاتَهُۥ فَأَقۡبَرَهُۥ","translation":"پھر اس کو موت دی پھر قبر میں دفن کرایا","transliteration":"Thumma amatahu faaqbarahu"},{"id":22,"text":"ثُمَّ إِذَا شَآءَ أَنشَرَهُۥ","translation":"پھر جب چاہے گا اسے اٹھا کھڑا کرے گا","transliteration":"Thumma itha shaa ansharahu"},{"id":23,"text":"كَلَّا لَمَّا يَقۡضِ مَآ أَمَرَهُۥ","translation":"کچھ شک نہیں کہ خدا نے اسے جو حکم دیا اس نے اس پر عمل نہ کیا","transliteration":"Kalla lamma yaqdi ma amarahu"},{"id":24,"text":"فَلۡيَنظُرِ ٱلۡإِنسَٰنُ إِلَىٰ طَعَامِهِۦٓ","translation":"تو انسان کو چاہیئے کہ اپنے کھانے کی طرف نظر کرے","transliteration":"Falyanthuri alinsanu ila taAAamihi"},{"id":25,"text":"أَنَّا صَبَبۡنَا ٱلۡمَآءَ صَبّٗا","translation":"بے شک ہم ہی نے پانی برسایا","transliteration":"Anna sababna almaa sabban"},{"id":26,"text":"ثُمَّ شَقَقۡنَا ٱلۡأَرۡضَ شَقّٗا","translation":"پھر ہم ہی نے زمین کو چیرا پھاڑا","transliteration":"Thumma shaqaqna alarda shaqqan"},{"id":27,"text":"فَأَنۢبَتۡنَا فِيهَا حَبّٗا","translation":"پھر ہم ہی نے اس میں اناج اگایا","transliteration":"Faanbatna feeha habban"},{"id":28,"text":"وَعِنَبٗا وَقَضۡبٗا","translation":"اور انگور اور ترکاری","transliteration":"WaAAinaban waqadban"},{"id":29,"text":"وَزَيۡتُونٗا وَنَخۡلٗا","translation":"اور زیتون اور کھجوریں","transliteration":"Wazaytoonan wanakhlan"},{"id":30,"text":"وَحَدَآئِقَ غُلۡبٗا","translation":"اور گھنے گھنے باغ","transliteration":"Wahadaiqa ghulban"},{"id":31,"text":"وَفَٰكِهَةٗ وَأَبّٗا","translation":"اور میوے اور چارا","transliteration":"Wafakihatan waabban"},{"id":32,"text":"مَّتَٰعٗا لَّكُمۡ وَلِأَنۡعَٰمِكُمۡ","translation":"(یہ سب کچھ) تمہارے اور تمہارے چارپایوں کے لیے بنایا","transliteration":"MataAAan lakum walianAAamikum"},{"id":33,"text":"فَإِذَا جَآءَتِ ٱلصَّآخَّةُ","translation":"تو جب (قیامت کا) غل مچے گا","transliteration":"Faitha jaati alssakhkhatu"},{"id":34,"text":"يَوۡمَ يَفِرُّ ٱلۡمَرۡءُ مِنۡ أَخِيهِ","translation":"اس دن آدمی اپنے بھائی سے دور بھاگے گا","transliteration":"Yawma yafirru almaro min akheehi"},{"id":35,"text":"وَأُمِّهِۦ وَأَبِيهِ","translation":"اور اپنی ماں اور اپنے باپ سے","transliteration":"Waommihi waabeehi"},{"id":36,"text":"وَصَٰحِبَتِهِۦ وَبَنِيهِ","translation":"اور اپنی بیوی اور اپنے بیٹے سے","transliteration":"Wasahibatihi wabaneehi"},{"id":37,"text":"لِكُلِّ ٱمۡرِيٕٖ مِّنۡهُمۡ يَوۡمَئِذٖ شَأۡنٞ يُغۡنِيهِ","translation":"ہر شخص اس روز ایک فکر میں ہو گا جو اسے (مصروفیت کے لیے) بس کرے گا","transliteration":"Likulli imriin minhum yawmaithin shanun yughneehi"},{"id":38,"text":"وُجُوهٞ يَوۡمَئِذٖ مُّسۡفِرَةٞ","translation":"اور کتنے منہ اس روز چمک رہے ہوں گے","transliteration":"Wujoohun yawmaithin musfiratun"},{"id":39,"text":"ضَاحِكَةٞ مُّسۡتَبۡشِرَةٞ","translation":"خنداں و شاداں (یہ مومنان نیکو کار ہیں)","transliteration":"Dahikatun mustabshiratun"},{"id":40,"text":"وَوُجُوهٞ يَوۡمَئِذٍ عَلَيۡهَا غَبَرَةٞ","translation":"اور کتنے منہ ہوں گے جن پر گرد پڑ رہی ہو گی","transliteration":"Wawujoohun yawmaithin AAalayha ghabaratun"},{"id":41,"text":"تَرۡهَقُهَا قَتَرَةٌ","translation":"(اور) سیاہی چڑھ رہی ہو گی","transliteration":"Tarhaquha qataratun"},{"id":42,"text":"أُوْلَـٰٓئِكَ هُمُ ٱلۡكَفَرَةُ ٱلۡفَجَرَةُ","translation":"یہ کفار بدکردار ہیں","transliteration":"Olaika humu alkafaratu alfajaratu"}]}
