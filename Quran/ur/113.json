{"id":113,"name":"الفلق","transliteration":"Al-Falaq","translation":"صبح","type":"meccan","total_verses":5,"verses":[{"id":1,"text":"قُلۡ أَعُوذُ بِرَبِّ ٱلۡفَلَقِ","translation":"کہو کہ میں صبح کے پروردگار کی پناہ مانگتا ہوں","transliteration":"Qul aAAoothu birabbi alfalaqi"},{"id":2,"text":"مِن شَرِّ مَا خَلَقَ","translation":"ہر چیز کی بدی سے جو اس نے پیدا کی","transliteration":"Min sharri ma khalaqa"},{"id":3,"text":"وَمِن شَرِّ غَاسِقٍ إِذَا وَقَبَ","translation":"اور شب تاریکی کی برائی سے جب اس کااندھیرا چھا جائے","transliteration":"Wamin sharri ghasiqin itha waqaba"},{"id":4,"text":"وَمِن شَرِّ ٱلنَّفَّـٰثَٰتِ فِي ٱلۡعُقَدِ","translation":"اور گنڈوں پر (پڑھ پڑھ کر) پھونکنے والیوں کی برائی سے","transliteration":"Wamin sharri alnnaffathati fee alAAuqadi"},{"id":5,"text":"وَمِن شَرِّ حَاسِدٍ إِذَا حَسَدَ","translation":"اور حسد کرنے والے کی برائی سے جب حسد کرنے لگے","transliteration":"Wamin sharri hasidin itha hasada"}]}
