{"id":108,"name":"الكوثر","transliteration":"Al-Kawthar","translation":"جنت کی نہر","type":"meccan","total_verses":3,"verses":[{"id":1,"text":"إِنَّآ أَعۡطَيۡنَٰكَ ٱلۡكَوۡثَرَ","translation":"(اے محمدﷺ) ہم نے تم کو کوثر عطا فرمائی ہے","transliteration":"Inna aAAtaynaka alkawthara"},{"id":2,"text":"فَصَلِّ لِرَبِّكَ وَٱنۡحَرۡ","translation":"تو اپنے پروردگار کے لیے نماز پڑھا کرو اور قربانی دیا کرو","transliteration":"Fasalli lirabbika wainhar"},{"id":3,"text":"إِنَّ شَانِئَكَ هُوَ ٱلۡأَبۡتَرُ","translation":"کچھ شک نہیں کہ تمہارا دشمن ہی بےاولاد رہے گا","transliteration":"Inna shaniaka huwa alabtaru"}]}
