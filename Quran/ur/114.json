{"id":114,"name":"الناس","transliteration":"An-Nas","translation":"انسان","type":"meccan","total_verses":6,"verses":[{"id":1,"text":"قُلۡ أَعُوذُ بِرَبِّ ٱلنَّاسِ","translation":"کہو کہ میں لوگوں کے پروردگار کی پناہ مانگتا ہوں","transliteration":"Qul aAAoothu birabbi alnnasi"},{"id":2,"text":"مَلِكِ ٱلنَّاسِ","translation":"(یعنی) لوگوں کے حقیقی بادشاہ کی","transliteration":"Maliki alnnasi"},{"id":3,"text":"إِلَٰهِ ٱلنَّاسِ","translation":"لوگوں کے معبود برحق کی","transliteration":"Ilahi alnnasi"},{"id":4,"text":"مِن شَرِّ ٱلۡوَسۡوَاسِ ٱلۡخَنَّاسِ","translation":"(شیطان) وسوسہ انداز کی برائی سے جو (خدا کا نام سن کر) پیچھے ہٹ جاتا ہے","transliteration":"Min sharri alwaswasi alkhannasi"},{"id":5,"text":"ٱلَّذِي يُوَسۡوِسُ فِي صُدُورِ ٱلنَّاسِ","translation":"جو لوگوں کے دلوں میں وسوسے ڈالتا ہے","transliteration":"Allathee yuwaswisu fee sudoori alnnasi"},{"id":6,"text":"مِنَ ٱلۡجِنَّةِ وَٱلنَّاسِ","translation":"وہ جنّات میں سے (ہو) یا انسانوں میں سے","transliteration":"Mina aljinnati wa alnnasm"}]}
