{"id":101,"name":"القارعة","transliteration":"Al-Qari'ah","translation":"کھڑکھڑاہٹ","type":"meccan","total_verses":11,"verses":[{"id":1,"text":"ٱلۡقَارِعَةُ","translation":"کھڑ کھڑانے والی","transliteration":"AlqariAAatu"},{"id":2,"text":"مَا ٱلۡقَارِعَةُ","translation":"کھڑ کھڑانے والی کیا ہے؟","transliteration":"Ma alqariAAatu"},{"id":3,"text":"وَمَآ أَدۡرَىٰكَ مَا ٱلۡقَارِعَةُ","translation":"اور تم کیا جانوں کھڑ کھڑانے والی کیا ہے؟","transliteration":"Wama adraka ma alqariAAatu"},{"id":4,"text":"يَوۡمَ يَكُونُ ٱلنَّاسُ كَٱلۡفَرَاشِ ٱلۡمَبۡثُوثِ","translation":"(وہ قیامت ہے) جس دن لوگ ایسے ہوں گے جیسے بکھرے ہوئے پتنگے","transliteration":"Yawma yakoonu alnnasu kaalfarashi almabthoothi"},{"id":5,"text":"وَتَكُونُ ٱلۡجِبَالُ كَٱلۡعِهۡنِ ٱلۡمَنفُوشِ","translation":"اور پہاڑ ایسے ہو جائیں گے جیسے دھنکی ہوئی رنگ برنگ کی اون","transliteration":"Watakoonu aljibalu kaalAAihni almanfooshi"},{"id":6,"text":"فَأَمَّا مَن ثَقُلَتۡ مَوَٰزِينُهُۥ","translation":"تو جس کے (اعمال کے) وزن بھاری نکلیں گے","transliteration":"Faamma man thaqulat mawazeenuhu"},{"id":7,"text":"فَهُوَ فِي عِيشَةٖ رَّاضِيَةٖ","translation":"وہ دل پسند عیش میں ہو گا","transliteration":"Fahuwa fee AAeeshatin radiyatin"},{"id":8,"text":"وَأَمَّا مَنۡ خَفَّتۡ مَوَٰزِينُهُۥ","translation":"اور جس کے وزن ہلکے نکلیں گے","transliteration":"Waamma man khaffat mawazeenuhu"},{"id":9,"text":"فَأُمُّهُۥ هَاوِيَةٞ","translation":"اس کا مرجع ہاویہ ہے","transliteration":"Faommuhu hawiyatun"},{"id":10,"text":"وَمَآ أَدۡرَىٰكَ مَا هِيَهۡ","translation":"اور تم کیا سمجھے کہ ہاویہ کیا چیز ہے؟","transliteration":"Wama adraka ma hiyah"},{"id":11,"text":"نَارٌ حَامِيَةُۢ","translation":"دہکتی ہوئی آگ ہے","transliteration":"Narun hamiyatun"}]}
