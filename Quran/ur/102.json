{"id":102,"name":"التكاثر","transliteration":"At-Takathur","translation":"کثرت","type":"meccan","total_verses":8,"verses":[{"id":1,"text":"أَلۡهَىٰكُمُ ٱلتَّكَاثُرُ","translation":"(لوگو) تم کو (مال کی) بہت سی طلب نے غافل کر دیا","transliteration":"Alhakumu alttakathuru"},{"id":2,"text":"حَتَّىٰ زُرۡتُمُ ٱلۡمَقَابِرَ","translation":"یہاں تک کہ تم نے قبریں جا دیکھیں","transliteration":"Hatta zurtumu almaqabira"},{"id":3,"text":"كَلَّا سَوۡفَ تَعۡلَمُونَ","translation":"دیکھو تمہیں عنقریب معلوم ہو جائے گا","transliteration":"Kalla sawfa taAAlamoona"},{"id":4,"text":"ثُمَّ كَلَّا سَوۡفَ تَعۡلَمُونَ","translation":"پھر دیکھو تمہیں عنقریب معلوم ہو جائے گا","transliteration":"Thumma kalla sawfa taAAlamoona"},{"id":5,"text":"كَلَّا لَوۡ تَعۡلَمُونَ عِلۡمَ ٱلۡيَقِينِ","translation":"دیکھو اگر تم جانتے (یعنی) علم الیقین (رکھتے تو غفلت نہ کرتے)","transliteration":"Kalla law taAAlamoona AAilma alyaqeeni"},{"id":6,"text":"لَتَرَوُنَّ ٱلۡجَحِيمَ","translation":"تم ضرور دوزخ کو دیکھو گے","transliteration":"Latarawunna aljaheema"},{"id":7,"text":"ثُمَّ لَتَرَوُنَّهَا عَيۡنَ ٱلۡيَقِينِ","translation":"پھر اس کو (ایسا) دیکھو گے (کہ) عین الیقین (آ جائے گا)","transliteration":"Thumma latarawunnaha AAayna alyaqeeni"},{"id":8,"text":"ثُمَّ لَتُسۡـَٔلُنَّ يَوۡمَئِذٍ عَنِ ٱلنَّعِيمِ","translation":"پھر اس روز تم سے (شکر) نعمت کے بارے میں پرسش ہو گی","transliteration":"Thumma latusalunna yawmaithin AAani alnnaAAeemi"}]}
