{"id":107,"name":"الماعون","transliteration":"Al-Ma'un","translation":"تھوڑی سی چیز","type":"meccan","total_verses":7,"verses":[{"id":1,"text":"أَرَءَيۡتَ ٱلَّذِي يُكَذِّبُ بِٱلدِّينِ","translation":"بھلا تم نے اس شخص کو دیکھا جو (روزِ) جزا کو جھٹلاتا ہے؟","transliteration":"Araayta allathee yukaththibu bialddeeni"},{"id":2,"text":"فَذَٰلِكَ ٱلَّذِي يَدُعُّ ٱلۡيَتِيمَ","translation":"یہ وہی (بدبخت) ہے، جو یتیم کو دھکے دیتا ہے","transliteration":"Fathalika allathee yaduAAAAu alyateema"},{"id":3,"text":"وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلۡمِسۡكِينِ","translation":"اور فقیر کو کھانا کھلانے کے لیے (لوگوں کو) ترغیب نہیں دیتا","transliteration":"Wala yahuddu AAala taAAami almiskeeni"},{"id":4,"text":"فَوَيۡلٞ لِّلۡمُصَلِّينَ","translation":"تو ایسے نمازیوں کی خرابی ہے","transliteration":"Fawaylun lilmusalleena"},{"id":5,"text":"ٱلَّذِينَ هُمۡ عَن صَلَاتِهِمۡ سَاهُونَ","translation":"جو نماز کی طرف سے غافل رہتے ہیں","transliteration":"Allatheena hum AAan salatihim sahoona"},{"id":6,"text":"ٱلَّذِينَ هُمۡ يُرَآءُونَ","translation":"جو ریا کاری کرتے ہیں","transliteration":"Allatheena hum yuraoona"},{"id":7,"text":"وَيَمۡنَعُونَ ٱلۡمَاعُونَ","translation":"اور برتنے کی چیزیں عاریتہً نہیں دیتے","transliteration":"WayamnaAAoona almaAAoona"}]}
