{"id":112,"name":"الإخلاص","transliteration":"Al-Ikhlas","translation":"اخلاص","type":"meccan","total_verses":4,"verses":[{"id":1,"text":"قُلۡ هُوَ ٱللَّهُ أَحَدٌ","translation":"کہو کہ وہ (ذات پاک جس کا نام) الله (ہے) ایک ہے","transliteration":"Qul huwa Allahu ahadun"},{"id":2,"text":"ٱللَّهُ ٱلصَّمَدُ","translation":"معبود برحق جو بےنیاز ہے","transliteration":"Allahu alssamadu"},{"id":3,"text":"لَمۡ يَلِدۡ وَلَمۡ يُولَدۡ","translation":"نہ کسی کا باپ ہے اور نہ کسی کا بیٹا","transliteration":"Lam yalid walam yooladu"},{"id":4,"text":"وَلَمۡ يَكُن لَّهُۥ كُفُوًا أَحَدُۢ","translation":"اور کوئی اس کا ہمسر نہیں","transliteration":"Walam yakun lahu kufuwan ahadun"}]}
